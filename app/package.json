{
  "name": "charuautos-app",
  "version": "1.0.0",
  "description": "El Copiloto Digital del Conductor Inteligente en Venezuela",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:apk": "eas build -p android --profile preview",
    "build:bundle": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile preview",
    "build:web": "expo export --platform web",
    "test:engine": "python src/domain/verify_engine.py",
    "test:scraper": "python src/domain/pdf_scraper_service.py",
    "test:storage": "python src/storage/verify_full_persistence_flow.py",
    "test:sync": "python src/storage/verify_sync_queue.py",
    "test:payments": "python src/storage/verify_payments.py",
    "verify:all": "python src/domain/verify_engine.py && python src/storage/verify_full_persistence_flow.py && python src/storage/verify_sync_queue.py && python src/storage/verify_payments.py"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-router": "~3.5.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "nativewind": "^2.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "tailwindcss": "3.3.2",
    "typescript": "^5.1.3"
  },
  "private": true
}
